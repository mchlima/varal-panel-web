# Variáveis do varal-panel-web. Copie para .env.local (fora do git) e ajuste.
# Em worktrees, scripts/worktree.sh new gera o .env.local sozinho (spec 01, seção 4.1).

# Nome do worktree (<tipo>-<descricao>). Vazio no checkout principal.
WORKTREE_SLUG=

# Deslocamento de portas do worktree: 0 no checkout principal, 1 a 99 nos worktrees (RN-01.08).
PORT_OFFSET=0

# Porta do servidor de desenvolvimento: 3100 + PORT_OFFSET.
PORT=3100

# URL base da API, fixada no build (app estático; cada ambiente tem o próprio build).
# Padrão: a API do checkout principal. Para usar a API de uma branch: http://localhost:<3000 + offset>.
# Produção: https://api-web-varal.kratinho.com.br
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Só para `pnpm gen:api`: caminho ou URL do openapi.json do varal-web-api.
# Padrão: ../varal-web-api/openapi.json, ao lado do checkout principal.
# OPENAPI_SOURCE=
